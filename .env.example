# Local development settings. `make dev` copies this to .env on first run.
# Every name here must also exist in internal/config (a test checks both ways).
# Values below are for your laptop only. Real secrets go in .env, never here.

# Shared
LOG_LEVEL=info
TOOLSERVER_TOKEN=local-dev-token-change-me
OTEL_EXPORTER_OTLP_ENDPOINT=
TICKET_RETENTION_DAYS=

# Migrations: `make migrate` connects as the table owner role (spec 0003)
MIGRATE_DATABASE_URL=postgres://noord_owner:noord-dev@localhost:55432/noord?sslmode=disable

# Agent
AGENT_HTTP_ADDR=:18080
AGENT_DATABASE_URL=postgres://noord_agent:noord-dev@localhost:55432/noord?sslmode=disable
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AGENT_MAX_TURNS=8
AGENT_TOOL_TIMEOUT=20s
AGENT_MESSAGE_TIMEOUT=45s
AGENT_MAX_RETRIES=2
AGENT_MAX_TOKENS_PER_TICKET=30000
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_IT_CHANNEL=
SLACK_IT_APPROVERS=
TOOLSERVER_URL=http://localhost:18081/mcp
SLACK_EVENT_DEDUP_TTL=24h

# Tool server
TOOLSERVER_HTTP_ADDR=:18081
TOOLSERVER_DATABASE_URL=postgres://noord_toolserver:noord-dev@localhost:55432/noord?sslmode=disable
LDAP_URL=ldaps://localhost:55636
LDAP_BASE_DN=DC=ad,DC=noord,DC=example
LDAP_BIND_DN="CN=svc-itsupport,OU=Service Accounts,OU=Noord,DC=ad,DC=noord,DC=example"
LDAP_BIND_PASSWORD=Bind-Dev-7xQ2
LDAP_CA_CERT=.dev/certs/ca.pem
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
ZAMMAD_URL=
ZAMMAD_TOKEN=
ZAMMAD_DEFAULT_GROUP=
READ_ONLY=true
KILL_SWITCH_FILE=
APPROVAL_TIMEOUT=
AUDIT_OUTCOME_RETRIES=3
AUDIT_WRITE_TIMEOUT=5s
AUDIT_MAX_PAYLOAD_BYTES=4096

# Directory seeder: `make seed` and `make directory-reset` build Noord's
# fictional Samba AD (spec 0004). Dev passwords use only [A-Za-z0-9_-] so
# bash and Compose read them the same way. LDAP_BIND_PASSWORD above also
# becomes the svc-itsupport password inside the Samba container.
SEED_LDAP_URL=ldaps://localhost:55636
SEED_CA_CERT=.dev/certs/ca.pem
SEED_ADMIN_USER=CN=Administrator,CN=Users,DC=ad,DC=noord,DC=example
SEED_ADMIN_PASSWORD=Root-Dev-7xQ2
SEED_USER_PASSWORD=Staff-Dev-7xQ2
SEED_FILE=seed/directory/noord.yaml
SEED_OVERLAY_FILE=seed/directory/overlay.local.yaml
SEED_WAIT_TIMEOUT=90s
