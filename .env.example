# Local development settings. `make dev` copies this to .env on first run.
# Every name here must also exist in internal/config (a test checks both ways).
# Values below are for your laptop only. Real secrets go in .env, never here.

# Shared
LOG_LEVEL=info
# At least 32 characters; both binaries refuse a shorter one (spec 0007).
TOOLSERVER_TOKEN=local-dev-toolserver-token-change-me
OTEL_EXPORTER_OTLP_ENDPOINT=
TICKET_RETENTION_DAYS=

# Migrations: `make migrate` connects as the table owner role (spec 0003)
MIGRATE_DATABASE_URL=postgres://noord_owner:noord-dev@localhost:55432/noord?sslmode=disable

# Agent
AGENT_HTTP_ADDR=:18080
AGENT_DATABASE_URL=postgres://noord_agent:noord-dev@localhost:55432/noord?sslmode=disable
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
# Required when both Slack tokens are set (feature #10).
ANTHROPIC_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AGENT_MAX_TURNS=8
AGENT_TOOL_TIMEOUT=20s
AGENT_MESSAGE_TIMEOUT=45s
AGENT_MAX_RETRIES=2
AGENT_MAX_TOKENS_PER_TICKET=30000
# Turns run at once, max_tokens per model call, shutdown grace (keep it under
# the pod's termination grace), and new conversations one person may start per hour.
AGENT_MAX_CONCURRENT=4
AGENT_MAX_RESPONSE_TOKENS=1024
AGENT_SHUTDOWN_GRACE=25s
AGENT_CONVERSATIONS_PER_HOUR=10
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# The private IT channel's id (C or G, then letters and digits; spec 0009).
# Required once both Slack tokens are set. Invite the bot to it by hand.
SLACK_IT_CHANNEL=
SLACK_IT_APPROVERS=
TOOLSERVER_URL=http://localhost:18081/mcp
SLACK_EVENT_DEDUP_TTL=24h

# Tool server
TOOLSERVER_HTTP_ADDR=:18081
TOOLSERVER_DATABASE_URL=postgres://noord_toolserver:noord-dev@localhost:55432/noord?sslmode=disable
LDAP_URL=ldaps://localhost:55636
LDAP_BASE_DN=DC=ad,DC=noord,DC=example
LDAP_BIND_DN="CN=svc-itsupport,OU=Service Accounts,OU=Noord,DC=ad,DC=noord,DC=example"
LDAP_BIND_PASSWORD=Bind-Dev-7xQ2
LDAP_CA_CERT=.dev/certs/ca.pem
LDAP_TIMEOUT=5s
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAX_RETRIES=5
GRAPH_TIMEOUT=30s
# Zammad (spec 0006): the noord-assistant token. `make helpdesk-reset`
# installs this exact value, so it survives every rebuild. At least 32
# characters from A-Za-z0-9_-.
ZAMMAD_URL=http://127.0.0.1:58080
ZAMMAD_TOKEN=dev-only-zammad-token-change-me-0001
ZAMMAD_DEFAULT_GROUP="IT Support"
ZAMMAD_TIMEOUT=15s
# The kill switch (spec 0007). With KILL_SWITCH_FILE set, only a file holding
# exactly read_write allows account changes, read on every call. Unset (local
# dev), READ_ONLY decides.
READ_ONLY=true
KILL_SWITCH_FILE=
APPROVAL_TIMEOUT=
AUDIT_OUTCOME_RETRIES=3
AUDIT_WRITE_TIMEOUT=5s
AUDIT_MAX_PAYLOAD_BYTES=4096
# The tool layer (spec 0007). The OU lists are relative to LDAP_BASE_DN and
# separated by ";" because DNs hold commas.
TOOL_CALL_TIMEOUT=15s
TOOLSERVER_MAX_REQUEST_BYTES=65536
TOOL_USER_OUS="OU=Users,OU=Noord"
TOOL_GROUP_OUS="OU=Groups,OU=Noord"
TOOL_DENIED_GROUPS=SG-IT-Admins,APP-Helpdesk-Agents,SYNC-Entra-Users
TOOL_WRITE_LIMIT=3
TOOL_WRITE_WINDOW=1h
TICKET_CREATE_LIMIT=5
TICKET_MAX_PENDING=720h
# Escalation (spec 0009): Zammad's browser URL for ticket links in the IT
# channel (optional), and the window for the blocked privileged attempt count.
ZAMMAD_PUBLIC_URL=http://127.0.0.1:58080
PRIVILEGED_ATTEMPT_WINDOW=24h

# Directory seeder: `make seed` and `make directory-reset` build Noord's
# fictional Samba AD (spec 0004). Dev passwords use only [A-Za-z0-9_-] so
# bash and Compose read them the same way. LDAP_BIND_PASSWORD above also
# becomes the svc-itsupport password inside the Samba container.
SEED_LDAP_URL=ldaps://localhost:55636
SEED_CA_CERT=.dev/certs/ca.pem
SEED_ADMIN_USER=CN=Administrator,CN=Users,DC=ad,DC=noord,DC=example
SEED_ADMIN_PASSWORD=Root-Dev-7xQ2
SEED_USER_PASSWORD=Staff-Dev-7xQ2
SEED_FILE=seed/directory/noord.yaml
SEED_OVERLAY_FILE=seed/directory/overlay.local.yaml
SEED_WAIT_TIMEOUT=90s
# svc-zammad's AD password; Compose hands it to Samba as SAMBA_ZAMMAD_PASSWORD.
SEED_ZAMMAD_BIND_PASSWORD=Zammad-Dev-7xQ2

# Helpdesk seeder (spec 0006): `make helpdesk-reset` rebuilds Zammad from
# seed/helpdesk/. The local admin below is used only by cmd/seed.
SEED_HELPDESK_DIR=seed/helpdesk
SEED_ZAMMAD_ADMIN_EMAIL=zammad-admin@noord.example
SEED_ZAMMAD_ADMIN_PASSWORD=Helpdesk-Dev-7xQ2
SEED_ZAMMAD_WAIT_TIMEOUT=10m

# Entra sync (spec 0005): `make entra-sync` makes the Entra tenant match
# SYNC-Entra-Users. Leave SEED_GRAPH_* empty and it skips. The setup steps are
# in docs/runbooks/entra-tenant.md. Real ids and secrets go in .env only.
SEED_GRAPH_TENANT_ID=
SEED_GRAPH_CLIENT_ID=
SEED_GRAPH_CLIENT_SECRET=
SEED_GRAPH_MAX_RETRIES=5
SEED_GRAPH_TIMEOUT=30s
SEED_ENTRA_DOMAIN=
SEED_ENTRA_DEMO_PASSWORD=
SEED_ENTRA_DEMO_FILE=seed/entra/demo.local.yaml
SEED_ENTRA_DELETE_LIMIT=10
SEED_ENTRA_CLEAR_WAIT=30s
