# Local development settings. `make dev` copies this to .env on first run.
# Every name here must also exist in internal/config (a test checks both ways).
# Values below are for your laptop only. Real secrets go in .env, never here.

# Shared
LOG_LEVEL=info
DATABASE_URL=postgres://noord:noord-dev@localhost:55432/noord?sslmode=disable
TOOLSERVER_TOKEN=local-dev-token-change-me
OTEL_EXPORTER_OTLP_ENDPOINT=
TICKET_RETENTION_DAYS=

# Agent
AGENT_HTTP_ADDR=:18080
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AGENT_MAX_TURNS=8
AGENT_TOOL_TIMEOUT=20s
AGENT_MESSAGE_TIMEOUT=45s
AGENT_MAX_RETRIES=2
AGENT_MAX_TOKENS_PER_TICKET=30000
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_IT_CHANNEL=
SLACK_IT_APPROVERS=
TOOLSERVER_URL=http://localhost:18081/mcp

# Tool server
TOOLSERVER_HTTP_ADDR=:18081
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_CA_CERT=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
ZAMMAD_URL=
ZAMMAD_TOKEN=
ZAMMAD_DEFAULT_GROUP=
READ_ONLY=true
KILL_SWITCH_FILE=
APPROVAL_TIMEOUT=
