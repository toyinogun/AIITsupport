{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/journal-check.py\"",
            "timeout": 15,
            "statusMessage": "Checking the build journal"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-go.py\"",
            "timeout": 300,
            "statusMessage": "Formatting the Go file"
          }
        ]
      }
    ]
  }
}
