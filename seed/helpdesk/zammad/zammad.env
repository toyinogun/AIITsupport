# Zammad's own Compose variables (spec 0006), read only to fill in the vendored
# compose.yaml. They stay out of the root .env and out of internal/config:
# nothing in our Go code reads them. The Postgres password guards a throwaway
# local database that only the Zammad containers can reach.
VERSION=7.2.2-0000
POSTGRES_USER=zammad
POSTGRES_PASS=zammad-dev
POSTGRES_DB=zammad_production
NGINX_PORT=8080
TZ=Europe/Amsterdam
