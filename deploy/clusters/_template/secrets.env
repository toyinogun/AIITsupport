# One cluster's secrets (spec 0015). make cluster-init copies this file to
# deploy/clusters/<name>/secrets.env, which git ignores: it ends up holding
# every secret of that install, so keep a copy somewhere safe.
#
# CHANGE_ME: you must fill it. Blank: optional, or generated by make install
# (it writes generated values back here once, and seals everything).
# A test keeps this list in step with internal/config and the chart's
# secret table (AC-7).

# The cluster
KUBE_CONTEXT=CHANGE_ME
INSTALL_TIMEOUT=30m
# Your tailnet's DNS name (example: tail1234.ts.net), for the helpdesk and reset URLs.
TAILNET=

# Generated once: the database role passwords and the agent to tool server token.
PG_OWNER_PASSWORD=
PG_AGENT_PASSWORD=
PG_TOOLSERVER_PASSWORD=
PG_EVAL_PASSWORD=
TOOLSERVER_TOKEN=

# Slack and the model (the agent). Leave the Slack pair blank to run the
# agent paused: health only, no Socket Mode.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_IT_CHANNEL=
SLACK_IT_APPROVERS=
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# The directory. With demo on, the URL is the in cluster Samba and the bind
# password is generated; the DNs are Noord's. With demo off, point these at
# your own directory and put its CA in values.yaml (ca.certificate).
LDAP_URL=
LDAP_BASE_DN=DC=ad,DC=noord,DC=example
LDAP_BIND_DN="CN=svc-itsupport,OU=Service Accounts,OU=Noord,DC=ad,DC=noord,DC=example"
LDAP_BIND_PASSWORD=

# The helpdesk. With demo on, the URL is the in cluster Zammad and the token
# is generated. With demo off, your Zammad's API URL and the assistant token.
ZAMMAD_URL=
ZAMMAD_TOKEN=
ZAMMAD_PUBLIC_URL=

# The demo directory's seed (demo on only). The passwords are generated;
# the Administrator DN is Noord's. SEED_GRAPH_* left blank skips the Entra
# sync (spec 0005).
SEED_ADMIN_USER="CN=Administrator,CN=Users,DC=ad,DC=noord,DC=example"
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SEED_ZAMMAD_BIND_PASSWORD=
SEED_ENTRA_DEMO_PASSWORD=
SEED_ENTRA_DOMAIN=
SEED_GRAPH_TENANT_ID=
SEED_GRAPH_CLIENT_ID=
SEED_GRAPH_CLIENT_SECRET=

# The demo helpdesk (demo on only). The passwords are generated; the admin
# is the local Zammad account only the seed uses.
SEED_ZAMMAD_ADMIN_EMAIL=zammad-admin@noord.example
SEED_ZAMMAD_ADMIN_PASSWORD=
ZAMMAD_POSTGRES_PASSWORD=
ZAMMAD_REDIS_PASSWORD=

# Password reset links (spec 0011), when reset.enabled is on. The page's URL
# comes from TAILNET; the password is generated in demo mode, and the DN is
# Noord's. With demo off, point both at your directory's reset account.
RESET_LDAP_BIND_DN="CN=svc-pwreset,OU=Service Accounts,OU=Noord,DC=ad,DC=noord,DC=example"
RESET_LDAP_BIND_PASSWORD=

# The tool server's Entra app (spec 0005). Optional: without it the tool
# server runs AD only. GRAPH_CERT_FILE is the path of a local PEM with the
# app's certificate and its key (absolute, or under the clone); use it or
# GRAPH_CLIENT_SECRET, not both.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_CERT_FILE=

# Backups to an S3 compatible bucket (an R2 bucket in the EU jurisdiction on k3sprox).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# The Tailscale operator's OAuth client, only when platform.tailscale is on.
TS_OAUTH_CLIENT_ID=
TS_OAUTH_CLIENT_SECRET=
