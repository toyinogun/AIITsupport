  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Resolved",
      "description": "Conversations closed as resolved in the range. Abandoned ones are never added here.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "noord-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "noord-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS resolved FROM ops.conversation_outcomes WHERE outcome = 'resolved' AND $__timeFilter(closed_at)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
