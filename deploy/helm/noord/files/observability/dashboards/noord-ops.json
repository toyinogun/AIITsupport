    {
      "id": 5,
      "type": "stat",
      "title": "Approvals waiting",
      "description": "Pending approvals right now, whatever the range, and the age of the oldest.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "noord-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "noord-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS waiting, coalesce(extract(epoch FROM now() - min(created_at)), 0)::float8 AS oldest_age_s FROM ops.approvals_open WHERE expires_at > now()"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "oldest_age_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "displayName",
                "value": "oldest"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "waiting"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Errors",
      "description": "Tool calls that ended in an error (audit log) plus agent failures, in the range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "noord-pg"
      },
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "noord-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (SELECT count(*) FROM ops.tool_calls WHERE outcome = 'error' AND $__timeFilter(occurred_at)) + (SELECT count(*) FROM ops.failures WHERE $__timeFilter(occurred_at)) AS errors"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Errors by stage",
      "description": "tool_result_error is a tool call that came back as an error; the other stages are agent failures (llm, tool unanswered, slack, sweep).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "noord-pg"
      },
      "gridPos": {
        "x": 7,
        "y": 4,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "noord-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT stage, count(*)::float8 AS errors FROM (SELECT 'tool_result_error' AS stage FROM ops.tool_calls WHERE outcome = 'error' AND $__timeFilter(occurred_at) UNION ALL SELECT stage FROM ops.failures WHERE $__timeFilter(occurred_at)) e GROUP BY stage ORDER BY stage"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "text"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "min": 0,
          "unit": "none",
          "noValue": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Account changes",
      "description": "The kill switch mode the tool server is enforcing. Unknown means the tool server has not checked in for 3 minutes.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "noord-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "noord-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN checked_at < now() - interval '3 minutes' THEN 'unknown' ELSE mode END AS mode FROM ops.kill_switch"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^mode$/",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "read_write": {
                  "text": "writes on",
                  "color": "green",
                  "index": 0
                },
                "read_only": {
                  "text": "read only",
                  "color": "orange",
                  "index": 1
                },
                "unknown": {
                  "text": "unknown",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "noValue": "unknown"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Mode since",
      "description": "When the mode last changed, as the tool server saw it (the first time it saw the mode, after a fresh start).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "noord-pg"
      },
      "gridPos": {
        "x": 15,
