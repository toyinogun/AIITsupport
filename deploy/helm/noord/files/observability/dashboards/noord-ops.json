          },
          "noValue": "unknown"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Cost",
      "description": "Model spend in US dollars for calls made in the range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "noord-pg"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "noord-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(cost_usd), 0)::float8 AS cost_usd FROM ops.llm_calls WHERE $__timeFilter(created_at)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Cost per conversation",
      "description": "Cost divided by the conversations that made model calls in the range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "noord-pg"
      },
      "gridPos": {
        "x": 21,
        "y": 4,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "noord-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (sum(cost_usd) / NULLIF(count(DISTINCT conversation_id), 0))::float8 AS cost_per_conversation FROM ops.llm_calls WHERE $__timeFilter(created_at)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "currencyUSD",
          "noValue": "no data",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Pending approvals",
      "description": "What is waiting for a human right now. No requester is shown.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "noord-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "noord-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT tool_name AS tool, risk_tier AS tier, approver_kind AS approver, extract(epoch FROM now() - created_at)::float8 AS age_s FROM ops.approvals_open WHERE expires_at > now() ORDER BY created_at"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "nothing waiting"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "age_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "displayName",
                "value": "age"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 12,
      "type": "barchart",
      "title": "Tool calls by tool and outcome",
      "description": "Outcome rows of the audit log in the range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "noord-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "noord-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT tool_name AS tool, count(*) FILTER (WHERE outcome = 'ok')::float8 AS ok, count(*) FILTER (WHERE outcome = 'error')::float8 AS error, count(*) FILTER (WHERE outcome = 'denied_policy')::float8 AS denied_policy, count(*) FILTER (WHERE outcome = 'denied_identity')::float8 AS denied_identity, count(*) FILTER (WHERE outcome = 'read_only')::float8 AS read_only, count(*) FILTER (WHERE outcome = 'pending_approval')::float8 AS pending_approval, count(*) FILTER (WHERE outcome = 'denied_approval')::float8 AS denied_approval, count(*) FILTER (WHERE outcome = 'expired')::float8 AS expired FROM ops.tool_calls WHERE $__timeFilter(occurred_at) GROUP BY tool_name ORDER BY tool_name"
        }
      ],
      "options": {
        "xField": "tool",
        "orientation": "horizontal",
        "stacking": "normal",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "showValue": "never"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "no tool calls"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "Recent conversations",
      "description": "The 50 most recent conversations, whatever the range. The trace link opens the conversation's trace in Tempo.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "noord-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "noord-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.conversation_id AS id, c.created_at AS started, c.status, c.outcome, coalesce(k.model_calls, 0) AS model_calls, k.cost_usd::float8 AS cost, c.duration_s AS duration, c.trace_id AS trace FROM ops.conversation_outcomes c LEFT JOIN ops.conversation_cost k USING (conversation_id) ORDER BY c.created_at DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": ""
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "trace"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^[0-9a-f]{32}$",
                      "result": {
                        "text": "open trace",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace in Tempo",
